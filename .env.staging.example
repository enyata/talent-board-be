# App runtime
NODE_ENV=staging
TALENTS_NODE_ENV=staging
TALENTS_PORT=8000
LOG_LEVEL=info

# Public URLs
TALENTS_BASE_URL=https://<staging-api-domain>
TALENTS_FRONTEND_URL=https://<staging-frontend-domain>

# Grafana Cloud Loki destination for staging logs
GRAFANA_CLUSTER=talent-board-staging
GRAFANA_LOKI_URL=https://<grafana-cloud-logs-endpoint>/loki/api/v1/push
GRAFANA_LOKI_USERNAME=<logs-username>
GRAFANA_LOKI_PASSWORD=<grafana-cloud-access-token>

# Grafana alerting to Slack for private channels
# Use the Slack incoming webhook URL for the private channel you want alerts to post to.
GRAFANA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<workspace>/<app>/<token>
GRAFANA_SLACK_CHANNEL=#private-alerts
